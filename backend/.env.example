PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=bug_tracker_db

# Security Configuration
# REQUIRED: Generate a strong random secret key. You can generate one in terminal using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Email / SMTP Settings (Gmail App Password)
# To use Gmail: Enable 2FA on your Google account and generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="BugTracker <no-reply@bugtracker.com>"
FRONTEND_URL=http://localhost:5173
